{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "academy/glossary",
  "title": "Academy glossary",
  "type": "object",
  "required": ["terms"],
  "additionalProperties": false,
  "properties": {
    "terms": {
      "type": "object",
      "description": "term id (URL slug) → term",
      "additionalProperties": {
        "type": "object", "required": ["term", "short", "category"], "additionalProperties": false,
        "properties": {
          "term": {"type": "string"},
          "short": {"type": "string", "maxLength": 180, "description": "the 1-line definition shown by Term on tap"},
          "long": {"type": "string"},
          "example": {"type": "string"},
          "category": {"type": "string", "enum": ["Markets", "Orders", "Costs", "Risk", "Charts", "Psychology", "Fundamentals", "Economy", "Portfolio"]},
          "related": {"type": "array", "items": {"type": "string"}},
          "added": {"type": "string"}
        }
      }
    }
  }
}
