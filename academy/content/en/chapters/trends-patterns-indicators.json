 "refresher": [
  {
   "idea": "read-the-swings",
   "title": "Lesson 1 · What a trend really is",
   "text": "Compare each swing with the last. Higher highs and higher lows: uptrend. Lower highs and lower lows: downtrend. No new highs or lows: sideways."
  },
  {
   "idea": "trendline-break-warning",
   "title": "Lesson 2 · Trendlines and channels",
   "text": "Draw the line under at least two rising lows. A break is a warning, not a signal: wait for lower highs and lower lows."
  },
  {
   "idea": "price-vs-average",
   "title": "Lesson 3 · Moving averages: the smoothed trend",
   "text": "Above a rising average: uptrend. Below a falling one: downtrend. The average lags, so it confirms the trend; it doesn’t predict it."
  },
  {
   "idea": "confirm-through-the-middle",
   "title": "Lesson 4 · Double tops and double bottoms",
   "text": "Two failed tries at a level are only a range until price closes through the middle point. No break, no pattern."
  },
  {
   "idea": "neckline-trigger",
   "title": "Lesson 5 · Head and shoulders",
   "text": "The pattern counts only on a close through the neckline. Patterns fail often, so a confirmed break still needs a stop."
  },
  {
   "idea": "overbought-isnt-sell",
   "title": "Lesson 6 · RSI: overbought isn’t a sell signal",
   "text": "RSI measures speed. Above 70 means price rose fast, not that it must fall: strong trends stay overbought for weeks."
  },
  {
   "idea": "macd-whipsaw",
   "title": "Lesson 7 · MACD in plain words",
   "text": "MACD crosses lag, and in a sideways market they flip back and forth. A cross confirms a trend; it’s never a reason on its own."
  },
  {
   "idea": "real-confluence",
   "title": "Lesson 8 · Confluence over clutter",
   "text": "Indicators built from the same prices repeat each other. Real confluence is trend, level and volume agreeing: three different questions."
  }
 ],
